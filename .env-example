AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=google.gemma-3-27b-it

# Supabase Auth (URL do projeto e publishable/anon key do ambiente)
# Obter em: Project Settings > API Keys. Ver docs/auth/supabase.md
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Storage (service_role key do ambiente)
# Obter em: Project Settings > API Keys
SUPABASE_STORAGE_URL=https://<ref>.supabase.co
SUPABASE_STORAGE_SERVICE_ROLE_KEY=<service_role_key>
