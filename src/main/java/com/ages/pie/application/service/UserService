package com.ages.pie.application.service;

import com.ages.pie.application.dto.UserRequestDTO;
import com.ages.pie.application.dto.UserResponseDTO;
import com.ages.pie.application.mapper.UserMapper;
import com.ages.pie.domain.entity.User;
import com.ages.pie.domain.enums.UserRole;
import com.ages.pie.infrastructure.repository.UserRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

/**
 * Exemplo de Application Service (caso de uso).
 *
 * Orquestra: recebe o DTO, aciona criação da Entity (que protege seus
 * próprios invariantes no construtor), salva via Repository, converte
 * para DTO de resposta via Mapper. É aqui que a transação acontece
 * (@Transactional).
 *
 * Regra para o time: se você perceber uma condição de negócio (tipo
 * "só pode criar se..."), pare e pergunte: isso é regra da Entity, de
 * uma Specification, ou realmente só orquestração? Regra de negócio que
 * "vaza" para o Service e cresce sem controle é o erro mais comum de
 * quem está aprendendo DDD.
 */
@Service
public class UserService {

    private final UserRepository userRepository;
    private final UserMapper userMapper;

    public UserService(UserRepository userRepository, UserMapper userMapper) {
        this.userRepository = userRepository;
        this.userMapper = userMapper;
    }

    @Transactional
    public UserResponseDTO criar(UserRequestDTO requestDTO) {
        // Aqui, a validação de "invariante" (nome vazio, email inválido)
        // já é protegida dentro do construtor de User — o Service não
        // precisa (e não deve) reimplementar essa checagem.
        User user = new User(
            requestDTO.name(),
            requestDTO.email(),
            criptografarSenha(requestDTO.password()),
            UserRole.CLIENTE
        );

        User salvo = userRepository.save(user);
        return userMapper.toResponseDTO(salvo);
    }

    private String criptografarSenha(String senhaPura) {
        // Placeholder — na implementação real, injete um PasswordEncoder
        // do Spring Security aqui em vez de simular a criptografia.
        return "hash(" + senhaPura + ")";
    }
}